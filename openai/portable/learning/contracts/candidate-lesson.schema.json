{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://savant-openai.local/contracts/candidate-lesson.schema.json",
  "title": "Savant bounded-learning candidate lesson",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "task_class",
    "observed_failure",
    "desired_behavior",
    "scope",
    "evidence",
    "confidence",
    "provenance",
    "redaction_status",
    "lifecycle_status",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "task_class": {
      "type": "string",
      "enum": ["proof", "statistics", "simulation", "reproducibility"]
    },
    "observed_failure": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "desired_behavior": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ref"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["fixture", "command", "user_correction", "source"]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "confidence": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "content_hash"],
      "properties": {
        "source_type": {
          "type": "string",
          "enum": ["verification", "user_correction", "evaluation"]
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[A-Za-z0-9]+$"
        }
      }
    },
    "redaction_status": {
      "type": "string",
      "enum": ["pending", "passed", "failed"]
    },
    "lifecycle_status": {
      "type": "string",
      "enum": ["candidate", "approved", "rejected", "superseded"]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
